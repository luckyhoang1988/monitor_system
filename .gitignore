# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Environment
.env
.env.local
*.env
.env.production
# Bản sao lưu/biến thể của file môi trường (vd .env.production.bak.<timestamp> do thao tác tay trên server)
# chứa SECRET_KEY/ENCRYPTION_KEY/mật khẩu thật — repo là PUBLIC, không bao giờ được commit.
.env.*
!.env.example

# Django
db.sqlite3
staticfiles/
media/

# IDE
.vscode/
.idea/
*.swp

# Testing
.coverage
htmlcov/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Debug logs
debug-*.log

# TLS certificates (private keys — never commit)
nginx/certs/

# Bảng tính chứa IP/tài khoản/mật khẩu thiết bị (vd "SERVER PFVNip.xlsx") — repo GitHub là PUBLIC
*.xlsx
*.xls

# Bản sao lưu cấu hình thiết bị (chứa community SNMP, hash mật khẩu...) — repo GitHub là PUBLIC
backups/

# Nơi làm việc tạm của agent (probe/dump thiết bị, script một lần) — không thuộc mã nguồn, có thể chứa dữ liệu thật
scratchpad/

# Cấu hình môi trường chạy Codex local (PYTHONPATH/LOG_LEVEL/ENV) — mỗi máy một khác, không ignore cả .codex/
.codex/config.toml

# Quyền/lệnh đã cho phép của Claude Code trên MÁY này — có thể kèm giá trị nhạy cảm, không ignore cả .claude/
.claude/settings.local.json
